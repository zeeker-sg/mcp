# Zeeker MCP Connector — Environment Variables
# Copy this file to .env and fill in values for local development.
# Do NOT commit .env with real values.

# URL of the upstream Datasette instance (required)
UPSTREAM_URL=http://datasette:8001

# Future env keys (populated in Plan 02 when config.py is created):
# USER_AGENT=mcp-zeeker/0.1
# TRUSTED_PROXY_DEPTH=1

# Owner full-access token shared with the zeeker-datasette stack. When set,
# search runs the BM25-ranked SQL path (SEARCH_RANKING defaults to bm25_rrf);
# empty → anonymous-tier access and SEARCH_RANKING falls back to "legacy".
# ZEEKER_FULL_ACCESS_TOKEN=

# Search ranking mode: legacy | bm25 | bm25_rrf. Defaults to bm25_rrf when
# ZEEKER_FULL_ACCESS_TOKEN is set, legacy otherwise.
# SEARCH_RANKING=bm25_rrf

# Wall-clock budget (seconds) for the per-search upstream fan-out. Targets
# still in flight when it expires are cancelled and counted in the envelope's
# failed_tables. Default 2.0.
# SEARCH_FAN_OUT_TIMEOUT_S=2.0
